# Allow only files required to build the Portal. The runtime image receives dist only.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!tsconfig.base.json
!apps/
!apps/portal/
!apps/portal/**
!packages/
!packages/demo-schema/
!packages/demo-schema/**
!packages/playground-ui/
!packages/playground-ui/**
!tools/
!tools/metadata.ts
!demos/
!demos/*/
!demos/*/demo.yaml
!demos/*/README.md
!infra/
!infra/azure/
!infra/azure/nginx.conf
**/node_modules
**/dist
**/.turbo
**/.env
**/.env.*
apps/portal/src/generated
