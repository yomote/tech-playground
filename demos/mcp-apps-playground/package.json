{
  "name": "@playground/mcp-apps-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.app.config.ts && vite build && tsc --noEmit",
    "dev": "pnpm build && tsx watch server.ts",
    "start": "tsx server.ts",
    "stdio": "tsx server.ts --stdio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "express": "^5.1.0",
    "zod": "^4.2.0",
    "@playground/ui": "workspace:*",
    "@mui/material": "9.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
