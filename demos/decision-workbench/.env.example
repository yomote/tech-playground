# Optional System One Adapter. This calls the provider/model you select, not Jev.
# Copy to this demo's .env and restart the demo. No model/provider is selected by default.
# Select codex (saved CLI login; no API key), openai, or anthropic.
DEMO_LLM_PROVIDER=
DEMO_LLM_MODEL=
# Leave blank for codex. Run codex login beforehand; the demo never reads auth files.
DEMO_LLM_API_KEY=

# Optional OpenAI-compatible endpoint, e.g. http://127.0.0.1:1234/v1
# Blank selects the official endpoint for DEMO_LLM_PROVIDER.
# For a local endpoint requiring no authentication, explicitly enter a placeholder
# DEMO_LLM_API_KEY yourself; the demo never invents a key or reads other demo secrets.
DEMO_LLM_BASE_URL=

# Direct Jev API; independent of the optional LLM comparison above.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
